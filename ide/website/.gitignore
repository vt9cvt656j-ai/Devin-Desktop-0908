node_modules
tsconfig.tsbuildinfo

# Search Console HTML-tag token. `.env.example` is the committed template.
# Parent `ide/.gitignore` has `.env.*`, which would also swallow this file —
# the negation has to live here or the template never reaches git.
.env
.env.local
.env.production
.env.*.local
!.env.example

# Build output — regenerated by `npm run build`, never the source of truth. The same
# rule the IDE applies to dist-web/, and for the same reason: a committed build drifts
# from the code that made it and nobody notices until production is running stale files.
dist

# public/app/ is NOT ignored on purpose. It is a vendored copy of the built IDE that the
# live embed on the page loads, no script regenerates it, and without it the site builds
# but the editor demo is blank.
