# Michael 总后台 — copy to `.env` and fill in. NEVER commit the real .env.

# --- required ---
DATABASE_URL=postgres://michael:CHANGE_ME@localhost:5432/michael
JWT_SECRET=CHANGE_ME_to_a_long_random_string

# --- optional (sane defaults shown) ---
REDIS_URL=redis://127.0.0.1:6379
BIND_ADDR=0.0.0.0:8080
DB_MAX_CONNECTIONS=20
CODE_TTL_SECS=600
JWT_TTL_SECS=2592000
RUST_LOG=info,sqlx=warn
IDE_UPDATE_MANIFEST_URL=https://github.com/fendoushaonian/Devin-Desktop/releases/latest/download/latest.json

# --- IDE signed release control (admin -> GitHub Actions) ---
# Fine-grained PAT: Metadata read, Actions read/write, Contents read/write.
# Keep the real token only in the server environment; the admin API never returns it.
IDE_RELEASE_GITHUB_TOKEN=
IDE_RELEASE_GITHUB_REPO=fendoushaonian/Devin-Desktop
IDE_RELEASE_GITHUB_WORKFLOW=ide-package.yml

# --- email. Two transports, both over HTTPS/443. Leave all empty for dev mode (codes go to the server log). ---
# 1) Cloudflare Worker "mrday-email-sender"（发件人 noreply@mrday.one，免费层 1000 封/天）。
#    两项都填才启用；启用后优先走它，发送失败且 Brevo 也配了则自动退回 Brevo。
EMAIL_WORKER_URL=
EMAIL_WORKER_KEY=
# 2) Brevo transactional API（MAIL_FROM 必填才算配好）。
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Mr. Day One
# 管理员通知邮件（线路告警 / 恢复、出口缺货、进价亏本）的合并窗口（秒）：这段时间里攒到的通知
# 合并成一封再发，同主题只留最新一条。默认 5 分钟，最小 10 秒。
ALARM_BATCH_WINDOW_SECS=300
# (legacy) QQ SMTP — no longer used to send; MAIL_FROM still falls back to QQ_SMTP_USER when empty.
QQ_SMTP_USER=
QQ_SMTP_PASS=
SMTP_HOST=smtp.qq.com

# --- used by docker-compose / deploy.sh (not by the app itself) ---
POSTGRES_USER=michael
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=michael

# michael-compression（1M/2M/5M 上下文压缩缓存）总开关。默认关闭。
#
# 开之前必须先修完发布前审查列出的阻断项，最关键的一条：compression_write_back
# 会把每条消息重写成 {role, content}，丢掉 tool_calls / tool_call_id —— agent
# 模式发的正是这些，上游会直接拒收。
#
# 注意这个开关同时控制 /api/me 是否对外报告档位。只报档位却不真压，会让客户端
# 关掉自己的本地压缩，结果两边都不压。
MICHAEL_COMPRESSION_ENABLED=0

# ── 代码托管连接（GitHub / Gitee）────────────────────────────────────────────────
#
# 账号页的「代码托管」模块用这两组凭据发起 OAuth；留空 = 该平台不显示为可连接，
# 按钮是灰的，而不是点下去跳到平台的报错页。
#
# OAuth App 必须由运营方在自己的 GitHub / Gitee 账号下注册 —— 应用属于那个身份，
# secret 也是他们的。回调地址必须与这里的 IDE_UPDATE_PUBLIC_BASE 完全一致：
#   GitHub  https://code.mrday.one/api/integrations/github/callback
#   Gitee   https://code.mrday.one/api/integrations/gitee/callback
#
# 申请的权限保持最小：GitHub 只要 repo + read:user，Gitee 只要 projects + user_info。
# 拿到的 access token 只存在 connected_accounts 表里，任何接口都不会把它发给前端 ——
# 一个带 repo 权限的 GitHub token 等于该用户全部私有仓库的读写权。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# ── 登录用的 OAuth 应用（/gate 上的 GitHub / Google 按钮）────────────────────────────
#
# 和上面那组**不是同一个应用**，不要复用。两个原因：一个 GitHub OAuth App 只能登记一个
# 回调地址，而这两条流程落在不同路径上；更重要的是上面那组要 `repo` —— 全部私有仓库的
# 读写权 —— 只是想登录的人不该看到那张授权页。登录这组只要 read:user user:email。
#
# 留空 = /gate 上对应的按钮保持 "Soon" 且点不动。加上之后按钮自动亮起来，不用改代码。
#
# 回调地址要和这里一字不差地登记到对方后台：
#   GitHub → https://code.mrday.one/api/auth/oauth/github/callback
#            https://github.com/settings/developers → New OAuth App
#   Google → https://code.mrday.one/api/auth/oauth/google/callback
#            https://console.cloud.google.com/apis/credentials → OAuth client ID → Web
#            application；并在 OAuth consent screen 里把 email / profile 两个 scope 留着
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── MSE-1 应用层加密（协议见 docs/MSE.md）──────────────────────────────────────────
#
# 我们自己的客户端（官网 / 用户后台 / 管理后台 / 桌面端）和网关之间，每个请求和响应都
# 封成密文。TLS 在 Cloudflare 终止一次、在 nginx 再终止一次，这两跳此前看得到全部明文、
# 全部 query、全部响应体；开了之后它们只看得到一团定长的二进制。

# 灰度档位。**桌面端能封包之前，这一行必须一直是 optional。**
#
#   off      中间件停摆。带 MSE 头的请求收 503（静默按明文处理会让客户端以为自己加密了）。
#   optional 明文密文都收，密文请求一定回密文响应。默认，也是灰度期唯一安全的档位。
#   required 受保护路由上的明文一律拒绝。
#
# 为什么不能提前打到 required：已经装在用户机器上的桌面端**没法自动更新**，它们只会发
# 明文。一旦 required，那些客户端的每个请求当场被拒，而且他们没有自救手段 —— 网关这边
# 改一个字，外面所有旧安装同时变砖。
#
# 换档顺序照 docs/MSE.md §11 走，一步都不能跳：optional 上线（配好下面的 MSE_SERVER_KEY）
# → 发布三个前端 → 盯 mse.sealed / mse.plain 两个计数器，直到受保护路由上剩下的明文只有
# 桌面端 → 发一版会封包的桌面端并等它铺开 → 这时候才轮到 required。
MSE_MODE=optional

# 网关的 P-384 长期私钥，base64（标准、带 padding）的 PKCS#8 DER。生成一把：
#
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-384 | openssl pkcs8 -topk8 -nocrypt -outform DER | openssl base64 -A
#
# 中间那道 pkcs8 -topk8 别省：OpenSSL 3.x 的 genpkey -outform DER 出来的是 SEC1 而不是
# PKCS#8。服务端两种都收，但别的工具基本只认 PKCS#8。
#
# 留空进程照样起得来 —— 它会临时造一把并打一条 warn —— 但那是**部署缺陷**，不是一个可选
# 项。留空的代价有两条：前端的密钥固定（VITE_MSE_PIN）永远对不上，于是「挡得住持有可信
# CA 的主动中间人」这一层直接不存在；而且每次重启换一把新的，所有在线客户端的会话密钥
# 当场全部作废。
MSE_SERVER_KEY=

# 轮换中的旧密钥。填上之后新旧两把都能解，但只有 MSE_SERVER_KEY 会作为当前密钥对外通告。
# 轮换步骤：新密钥写进 MSE_SERVER_KEY，旧的挪到这里，用两个 kid 重新构建固定了密钥的前端，
# 等外面不再有固定到旧 kid 的构建之后再清空这一行。
# 两行填成同一把密钥进程会直接拒绝启动：那种配置看起来轮换过了，实际什么都没换。
MSE_SERVER_KEY_PREV=

# 对外通告的会话寿命，同时也是服务端派生缓存的 TTL。缓存被淘汰、进程重启、换一个实例，
# 代价都只是多做一次 ECDH，不会失败，也不需要重新握手。
MSE_SESSION_TTL_SECS=1800

# 前向保密：服务器**临时密钥**的轮换周期（秒）。默认 600（10 分钟）。
#
# 静态密钥（MSE_SERVER_KEY）现在只**签名**这把轮换的临时密钥，不再参与 ECDH。真正的 DH
# 用临时密钥，用完即弃。于是：将来偷到静态私钥，也解不了录下来的历史流量——它从没握过
# DH 秘密。这一档越短，一旦服务器内存被读取，能倒推的流量窗口越小；但太短会让 pubkey
# 回源更频繁。老桌面端（封给静态 kid）继续走静态 ECDH、没有前向保密但不掉线。
MSE_EPHEMERAL_TTL_SECS=600

# 允许的 X-Mse-Ts 偏差（毫秒）。客户端拿 /api/crypto/pubkey 里的 server_time 校正过自己的
# 时钟才发请求，所以这一档挡的是重放，不是「用户电脑时间不准」—— 后者已经在客户端消掉了。
MSE_MAX_SKEW_MS=120000

# 单个密文信封的上限（字节），请求和响应都走这道闸。64 MiB。
#
# 注意 docs/MSE.md §10 那张表里写的还是 37748736（36 MiB），已经过时，以这里为准。36 MiB
# 是照 JSON body 估的，而非 JSON 的 body（/api/deploy 传的原始归档）在信封里走 base64 的
# `raw` 字段，要涨 4/3：
#
#   35 MiB 归档 = 36,700,160 B → base64url 48,933,547 B → 加 JSON 外壳与信封头尾 ≈ 48,933,634 B ≈ 46.7 MiB
#
# 也就是说 36 MiB 这个值会让超过约 27 MiB 的部署包被加密层砍掉，而且报错落在一个和「包太大」
# 毫无关系的地方。JSON body 不受影响：它以对象形态放进信封的 `b` 字段，不过 base64。
#
# 真正的外层闸门不在这里，是 nginx 的 client_max_body_size 55m（57,671,680 B）：46.7 MiB
# 的密文离它还有 8.3 MiB 余量，35 MiB 的部署走得通；但 55m 换算回明文归档只到约 41 MiB，
# 所以哪天要把 /api/deploy 抬过 41 MiB，得先改 nginx，光调大这一行没有用。
MSE_MAX_SEALED_BYTES=67108864

# Redis 答不上「这个 (sid, seq) 见过没有」时放行还是拒绝。默认 0 = 拒绝。
# 改成 1，Redis 抖一下就是一个可重放窗口 —— 重放防护整个只由那一个键撑着，没有第二道。
MSE_REPLAY_FAIL_OPEN=0

# 把外层 HTTP 状态码统一改写成 200，真状态码封在密文里由 GCM tag 保护。默认 0 = 不改写。
# 开了之后 nginx 日志和 Cloudflare 分析里 200 和 500 长得一模一样：拿可观测性换掉一点点
# 流量特征，代价是下次故障没人会先发现。想清楚再开。
MSE_MASK_STATUS=0

# 前端那三个（VITE_MSE_PIN / VITE_MSE_MODE / VITE_MSE_BASE）是**构建期**变量，写在各自
# 前端自己的 .env 里，放这里不生效。其中 VITE_MSE_PIN=<kid>[,<kid>] 是把 MSE 从「对被动
# 中间人不透明」抬到「对主动中间人不透明」的那一步，密钥轮换时要跟着一起改。

# ── 落库字段加密（data at rest，见 src/field_crypto.rs）──────────────────────────
#
# 敏感字段进 Postgres 前用这把密钥加密：上游 api_key、GitHub/GitLab 令牌、提现账户、收款 QR。
# 拖库的人拿到的是 fc1:... 的密文，他有全世界的标准库也解不开 —— 因为这把密钥不在数据库里。
# 这是唯一一处「别人的标准库真的解不开我的数据」字面成立的地方，成立的原因是密钥托管，
# 不是算法。
#
# 生成一把（32 字节，base64）：
#   openssl rand -base64 32
#
# 留空 = 关闭：敏感字段以明文存库，全链路零行为变化（可安全先上线，之后再补密钥）。配了之后：
#   - 新写入自动加密；旧行仍是明文、读时照常认（读时两种都认，没有 flag-day）；
#   - 启动时后台任务把存量明文逐行加密回去（幂等，见 field_backfill.rs）。
#
# ⚠️ 回填之后这把密钥丢了 = 那些字段**永久无法恢复**。必须离线备份，而且和数据库备份**分开**
# 存 —— 否则「密钥不在数据库那份东西里」这个前提就没了，加密也就白做。
FIELD_ENC_KEY=
