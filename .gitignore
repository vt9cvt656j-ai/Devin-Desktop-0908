# Rust
/target
**/target

# Node
node_modules
npm-debug.log*
yarn-error.log*

# Vite build output (regenerated by `npm run build`)
/dist

# Tauri generated
/src-tauri/gen
/src-tauri/target

# Local screenshots used while authoring (not part of the app)
.screenshot-*.png

# Env / secrets
.env
.env.*
!server/.env.test.example  # 模板，无密钥
.mcp.local.json
**/.mcp.local.json

# Editor / OS
.DS_Store
__pycache__/
*.py[cod]
.idea/

# Ignore personal VS Code state, but keep the shared workspace config below.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# build artifacts + editor backups (added for CI packaging, 2026-07-04)
*.bak
*.bak.*
*.pre-*
server/src/src/
/*.dmg
.michael-images/
ide/src/_serve.mjs
ide/src/*-test.html

# Claude Code local state (本机会话配置，per-machine，不该进仓库)
.claude/
.local-backup/

# Microsoft Word / Excel 等 Office 临时锁文件（"~$" 前缀）
~*.docx
~*.doc
~*.xlsx
~*.xls
~*.pptx
~*.ppt
